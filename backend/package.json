{
  "name": "edugate-backend",
  "version": "1.0.0",
  "description": "EDUGATE Global CRM Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 src/tests/clientRelationshipDisambiguation.test.js src/tests/referralManagement.test.js src/tests/referralPipelineQualification.test.js",
    "test:disambiguation": "node --test src/tests/clientRelationshipDisambiguation.test.js",
    "test:pipeline-referral": "node --test src/tests/referralPipelineQualification.test.js",
    "test:all": "node --test --test-concurrency=1 src/tests/*.test.js",
    "test:journey": "node --test src/tests/studentJourney.test.js",
    "test:referrals": "node --test src/tests/referralManagement.test.js",
    "reset:notifications": "node src/database/reset_notifications.js",
    "clean:test-data": "node scripts/clean-referral-test-data.js"
  },
  "keywords": [
    "crm",
    "edugate",
    "express",
    "supabase",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-type": "^22.1.1",
    "googleapis": "^181.0.0",
    "imap-simple": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.47",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "nodemon": "^3.1.9",
    "pg": "^8.23.0"
  }
}
